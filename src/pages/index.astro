---
/* La pagina. Una sola, en el orden en que se lee un domingo: la barra, la
   portada, por donde se entra, y que pasa adentro. */

import Base from "../layouts/Base.astro";
import Portada from "../componentes/Portada.astro";
import Llegar from "../componentes/Llegar.astro";
import Umbral from "../componentes/Umbral.astro";
import LineaDeTiempo from "../componentes/LineaDeTiempo.astro";
import Preguntas from "../componentes/Preguntas.astro";
import Ninos from "../componentes/Ninos.astro";
import Predicas from "../componentes/Predicas.astro";
import Quienes from "../componentes/Quienes.astro";
import Invitar from "../componentes/Invitar.astro";
import Cierre from "../componentes/Cierre.astro";
import { IGLESIA, CULTOS } from "../datos/iglesia";
import { finDe } from "../lib/candado";

/* La descripcion tambien sale de los datos. Estaba escrita a mano con la hora y
   la calle dentro, asi que cambiar el horario en iglesia.ts dejaba mintiendo
   justo el texto que Google ensena. */
const domingo = CULTOS.find((c) => c.principal)!;
const titulo = `${IGLESIA.nombreCompleto} en ${IGLESIA.ciudad}, ${IGLESIA.estado}`;
const descripcion =
  `${domingo.dia}s de ${domingo.hora} a ${finDe(domingo)} en el ` +
  `${IGLESIA.calle.replace(/^Callejón/, "callejón")}, ${IGLESIA.colonia}, ${IGLESIA.ciudad}. ` +
  `Cuánto dura, por dónde se entra y qué pasa en tu primera visita.`;
---

<Base titulo={titulo} descripcion={descripcion} primeraPantalla>
  <Portada slot="primera" />
  <Llegar />
  <Umbral />
  <LineaDeTiempo />
  <Preguntas />
  <Ninos />
  <Predicas />
  <Quienes />
  <Invitar />
  <Cierre slot="pie" />
</Base>
