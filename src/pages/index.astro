---
import Base from "../layouts/Base.astro";
import Celosia from "../componentes/Celosia.astro";
import {
  IGLESIA,
  COMO_LLEGAR,
  CULTOS,
  PRIMERA_VEZ,
  NINOS,
  LIDERAZGO,
  PREDICAS,
  PROXIMO_TEMA,
} from "../datos/iglesia";
import { enlaceWhatsApp, invitacion } from "../lib/candado";

const domingo = CULTOS.find((c) => c.principal)!;
const entreSemana = CULTOS.filter((c) => !c.principal);

const waVisita = enlaceWhatsApp(
  IGLESIA.whatsapp,
  `Hola. Vi la página de Bethel y quiero ir el domingo. ¿Alguien me puede recibir en la puerta?`,
);
const waGeneral = enlaceWhatsApp(IGLESIA.whatsapp, `Hola. Vi la página de Bethel y tengo una pregunta.`);
const waInvitar = invitacion({
  ciudad: IGLESIA.ciudad,
  colonia: IGLESIA.colonia,
  hora: domingo.hora,
  fin: domingo.fin,
  tema: PROXIMO_TEMA,
  /* El enlace que viaja dentro de la invitacion de WhatsApp. Se arma desde la
     configuracion, no a mano: si el sitio cambia de direccion, cambia aqui. */
  sitio: new URL(import.meta.env.BASE_URL, Astro.site).href,
});

const anio = new Date().getFullYear();
---

<Base
  titulo={`${IGLESIA.nombreCompleto} en ${IGLESIA.ciudad}, ${IGLESIA.estado}`}
  descripcion={`Domingos a las ${domingo.hora} en ${IGLESIA.direccion}, ${IGLESIA.ciudad}. Qué esperar en tu primera visita, cuánto dura y por dónde se entra.`}
>
  <!-- ═══════ BARRA FIJA ═══════
       Horario, colonia y los dos botones. No depende de desplazar ni de un clic:
       el 43% entra buscando el horario y el 28% buscando cómo llegar. -->
  <header class="barra no-imprimir">
    <div class="envoltura barra__caja">
      <p class="barra__cuando">
        <span class="dato">{domingo.dia}s {domingo.hora}</span>
        <span class="barra__donde">{IGLESIA.colonia}, {IGLESIA.ciudad}</span>
      </p>
      <div class="barra__acciones">
        <a class="boton boton--whatsapp" href={waGeneral} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
        <a class="boton" href="#llegar">Cómo llegar</a>
      </div>
    </div>
  </header>

  <main>
    <!-- ═══════ 1. PORTADA ═══════
         La frase da permiso en vez de pedir entusiasmo: el 49% de la gente sin
         fe ve al cristianismo como hipócrita, así que el entusiasmo excesivo
         confirma la sospecha de venta en vez de desactivarla. -->
    <section class="portada" aria-labelledby="t-portada">
      <div class="portada__luz" aria-hidden="true"></div>

      <!-- El muro de celosia por el que entra la luz. Decorativo y fuera del
           arbol de accesibilidad: no dice nada que el texto no diga. -->
      <div class="portada__muro" aria-hidden="true">
        <Celosia columnas={6} filas={9} />
      </div>

      <div class="envoltura portada__caja">
        <p class="rotulo">{IGLESIA.nombreCompleto} · {IGLESIA.ciudad}, {IGLESIA.estado}</p>

        <h1 id="t-portada" class="portada__frase">Aquí se puede llegar cansado.</h1>
        <p class="portada__apoyo">No hace falta que traigas nada resuelto.</p>

        <!-- La franja de luz cae justo aquí: el elemento más bonito de la página
             señala el dato más útil. -->
        <dl class="cuando">
          <div class="cuando__fila">
            <dt class="rotulo">Domingos</dt>
            <dd>
              <span class="dato cuando__hora">{domingo.hora}</span>
              <span class="cuando__nota">Salimos como a las {domingo.fin}. Son {domingo.minutos} minutos.</span>
            </dd>
          </div>
          <div class="cuando__fila">
            <dt class="rotulo">Dónde</dt>
            <dd>
              <span class="cuando__dir">{IGLESIA.direccion}</span>
              <span class="cuando__nota">{IGLESIA.ciudad}, {IGLESIA.estado}. Está {IGLESIA.referencia}.</span>
            </dd>
          </div>
        </dl>

        <div class="portada__acciones">
          <a class="boton" href="#primera-vez">Qué pasa en el culto</a>
          <a class="boton boton--sobrio" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/domingo.ics`}>Guardar en mi calendario</a>
        </div>
      </div>
    </section>

    <!-- ═══════ 2. TU PRIMERA VEZ ═══════
         Las siete preguntas contestadas CON EL DATO, no con la promesa del dato.
         De siete sitios de iglesias analizados, dos anuncian que responderán y
         no responden. Ese es el error que aquí no se comete. -->
    <section id="primera-vez" class="seccion seccion--crema" aria-labelledby="t-primera">
      <div class="envoltura">
        <p class="rotulo">Si nunca has venido</p>
        <h2 id="t-primera" class="entra">Esto es lo que va a pasar</h2>

        <!-- Primero la puerta: es el miedo número uno documentado, no saber a
             dónde ir al llegar. -->
        <article class="pregunta entra">
          <h3><span class="pregunta__num" aria-hidden="true">01</span>¿Por dónde entro?</h3>
          <p>
            {IGLESIA.direccion}, {IGLESIA.referencia}. Se entra por <strong>{COMO_LLEGAR.puerta}</strong>.{" "}
            {COMO_LLEGAR.otraPuerta}
          </p>
          <p>{COMO_LLEGAR.estacionamiento} {COMO_LLEGAR.siSeLlena} {COMO_LLEGAR.distancia}</p>
          <p><strong>{COMO_LLEGAR.llegarTarde}</strong></p>
        </article>

        <article class="pregunta entra">
          <h3><span class="pregunta__num" aria-hidden="true">02</span>¿Cuánto dura?</h3>
          <p>
            Empieza a las <span class="dato">{domingo.hora}</span> y termina cerca de las{" "}
            <span class="dato">{domingo.fin}</span>. Son unos <span class="dato">{domingo.minutos} minutos</span>.{" "}
            {PRIMERA_VEZ.salir}
          </p>
        </article>

        <article class="pregunta entra">
          <h3><span class="pregunta__num" aria-hidden="true">03</span>¿Qué va a pasar, minuto a minuto?</h3>
          <ol class="minutos">
            {
              PRIMERA_VEZ.tramos.map((t) => (
                <li>
                  <span class="minutos__rango dato">{t.rango}</span>
                  <span class="minutos__texto">{t.texto}</span>
                </li>
              ))
            }
          </ol>
        </article>

        <article class="pregunta entra">
          <h3><span class="pregunta__num" aria-hidden="true">04</span>¿Cómo me visto?</h3>
          <p>{PRIMERA_VEZ.vestimenta}</p>
        </article>

        <article class="pregunta entra">
          <h3><span class="pregunta__num" aria-hidden="true">05</span>¿Me van a señalar o pedir que me presente?</h3>
          <p>{PRIMERA_VEZ.senalar}</p>
          <p>{PRIMERA_VEZ.acompanar}</p>
        </article>

        <article class="pregunta entra destacado vidrio">
          <h3><span class="pregunta__num" aria-hidden="true">06</span>¿Me van a pedir dinero?</h3>
          <p>{PRIMERA_VEZ.ofrenda}</p>
        </article>

        <article class="pregunta entra">
          <h3><span class="pregunta__num" aria-hidden="true">07</span>¿Qué hago con mis hijos?</h3>
          <p>
            Los niños {NINOS.edades} tienen su propio salón durante el culto, con{" "}
            <span class="dato">{NINOS.adultos} adultos</span> a cargo. Los dejas en {NINOS.salon} antes de
            entrar.{" "}{NINOS.quedarse}
          </p>
          <p><a href="#ninos">Cómo funciona la entrega y la recogida</a></p>
        </article>

        <p class="entra">
          <a class="boton boton--whatsapp" href={waVisita} target="_blank" rel="noopener noreferrer">
            Avísanos que vienes y te esperamos en la puerta
          </a>
        </p>
      </div>
    </section>

    <div class="cenefa" aria-hidden="true"></div>

    <!-- ═══════ 3. CÓMO LLEGAR ═══════
         Mapa como imagen con enlace, nunca embebido: un iframe de Google Maps
         pesa más que uno de YouTube, y quien busca el mapa quiere llegar, no
         navegar. -->
    <section id="llegar" class="seccion" aria-labelledby="t-llegar">
      <div class="envoltura llegar">
        <div>
          <p class="rotulo">Cómo llegar</p>
          <h2 id="t-llegar" class="entra">{IGLESIA.direccion}</h2>
          <p class="entra">{IGLESIA.ciudad}, {IGLESIA.estado}. Está {IGLESIA.referencia}.</p>
          <p class="entra">Se entra por {COMO_LLEGAR.puerta}. {COMO_LLEGAR.estacionamiento}</p>
          <p class="entra">
            <a class="boton" href={COMO_LLEGAR.mapa} target="_blank" rel="noopener noreferrer">
              Abrir en el mapa
            </a>
          </p>

          <h3 class="entra llegar__sub">Y entre semana</h3>
          <ul class="horarios entra">
            {
              entreSemana.map((c) => (
                <li>
                  <span class="dato">{c.dia} {c.hora}</span>
                  <span>{c.nombre}, unos {c.minutos} minutos</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Hueco reservado para la foto real de la fachada. Va vacío a
             propósito: una foto de banco aquí tumbaría la credibilidad de todos
             los datos de arriba, no solo la suya. -->
        <figure class="hueco entra">
          <div class="hueco__caja">
            <Celosia columnas={4} filas={3} />
            <p class="rotulo">Aquí va la foto de la fachada</p>
          </div>
          <figcaption class="pista">
            La fachada desde la calle y {COMO_LLEGAR.puerta}, para que la reconozcas antes de llegar.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══════ 4. NIÑOS, PRESENTADO COMO SEGURIDAD ═══════
         Es el único punto donde cumplir la ley y convencer apuntan al mismo
         lado: el 65% de los padres lo considera factor de decisión.
         Ninguna foto ni nombre de menor, tampoco en el texto alternativo. -->
    <section id="ninos" class="seccion seccion--crema" aria-labelledby="t-ninos">
      <div class="envoltura">
        <p class="rotulo">Con los niños</p>
        <h2 id="t-ninos" class="entra">Cómo los cuidamos</h2>

        <ul class="protocolo entra">
          <li class="vidrio"><strong>Entrega y recogida.</strong> {NINOS.protocolo}</li>
          <li class="vidrio"><strong>Nunca solos.</strong> {NINOS.dosAdultos}</li>
          <li class="vidrio"><strong>Quién está con ellos.</strong> {NINOS.antecedentes}</li>
          <li class="vidrio"><strong>Si prefieres tenerlo contigo.</strong> {NINOS.quedarse}</li>
        </ul>

        <h3 class="entra">Los responsables</h3>
        <ul class="personas entra">
          {
            NINOS.responsables.map((p) => (
              <li>
                <span class="personas__nombre">{p.nombre}</span>
                <span class="personas__funcion">{p.funcion}</span>
              </li>
            ))
          }
        </ul>

        <p class="pista entra">
          En esta página no publicamos fotos ni nombres de niños. Si quieres conocer el salón antes
          de traerlos, avísanos y te lo enseñamos.
        </p>
      </div>
    </section>

    <div class="cenefa" aria-hidden="true"></div>

    <!-- ═══════ 5. PRÉDICAS ═══════
         La calidad de la predicación es el factor número uno de elección, con
         83%. Va con la duración visible, que casi nadie publica.
         Sin embebido: el iframe de YouTube pesa 583 KB, contra 10 de la
         miniatura. Se carga solo si la persona decide verlo. -->
    <section id="predicas" class="seccion" aria-labelledby="t-predicas">
      <div class="envoltura">
        <p class="rotulo">Lo que se predicó</p>
        <h2 id="t-predicas" class="entra">Prédicas</h2>
        <p class="entra">Puedes oír una antes de venir, para saber cómo se enseña aquí.</p>

        <ul class="predicas entra">
          {
            PREDICAS.map((p) => (
              <li class="predica vidrio">
                <h3 class="predica__titulo">{p.titulo}</h3>
                <p class="predica__meta">
                  <span class="dato">{p.minutos} min</span>
                  <span>{p.fecha}</span>
                  <span>{p.predicador}</span>
                </p>
              </li>
            ))
          }
        </ul>
        <p class="pista entra">
          Las prédicas se publican en el canal de la iglesia. Esta lista se actualiza sola desde ahí.
        </p>
      </div>
    </section>

    <!-- ═══════ 6. QUIÉNES SOMOS ═══════
         Con seguimiento ocular está medido que la gente mira los retratos del
         personal real 10% más que sus biografías, aunque ocupen tres veces menos
         espacio. La variable que lo hace funcionar es que sean personas que de
         verdad están ahí. -->
    <section id="quienes" class="seccion seccion--crema" aria-labelledby="t-quienes">
      <div class="envoltura">
        <p class="rotulo">Quiénes somos</p>
        <h2 id="t-quienes" class="entra">La gente que vas a ver</h2>
        <p class="entra">{IGLESIA.historia}</p>

        <ul class="liderazgo entra">
          {
            LIDERAZGO.map((p) => (
              <li class="lider">
                <div class="lider__hueco" aria-hidden="true">
                  <span class="rotulo">Foto</span>
                </div>
                <h3 class="lider__nombre">{p.nombre}</h3>
                <p class="lider__funcion">{p.funcion}</p>
                <p class="lider__contexto">{p.contexto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="cenefa" aria-hidden="true"></div>

    <!-- ═══════ 7. INVITA A ALGUIEN ═══════
         El mecanismo con más respaldo de toda la investigación: la gente va
         cuando alguien de confianza la invita, se ofrece a acompañarla, y hay
         razón para creer que le va a servir para algo que le duele.
         El sitio no convence al desconocido: arma al miembro. -->
    <section id="invitar" class="seccion" aria-labelledby="t-invitar">
      <div class="envoltura invitar">
        <p class="rotulo">Para quien ya viene</p>
        <h2 id="t-invitar" class="entra">Invita a alguien</h2>
        <p class="entra">
          Casi nadie llega a una iglesia por internet. Llega porque alguien lo invitó y se ofreció a
          acompañarlo. Este botón arma el mensaje: solo le pones el nombre y lo mandas.
        </p>

        <blockquote class="mensaje vidrio entra">
          <p>Hola. Este domingo voy a la iglesia Bethel, aquí en {IGLESIA.colonia}.</p>
          <p>Empieza a las {domingo.hora} y salimos como a las {domingo.fin}.</p>
          <p>Si quieres paso por ti y entramos juntos. No tienes que hacer nada ni decir nada allá.</p>
          {PROXIMO_TEMA && <p>Este domingo hablan de: {PROXIMO_TEMA}.</p>}
        </blockquote>

        <p class="entra">
          <a class="boton boton--whatsapp" href={waInvitar} target="_blank" rel="noopener noreferrer">
            Mandar esta invitación
          </a>
        </p>
      </div>
    </section>
  </main>

  <!-- ═══════ PIE ═══════ -->
  <footer class="pie">
    <div class="envoltura pie__rejilla">
      <div>
        <p class="rotulo">Dónde</p>
        <p>{IGLESIA.nombreCompleto}</p>
        <p>{IGLESIA.direccion}</p>
        <p>{IGLESIA.ciudad}, {IGLESIA.estado}</p>
      </div>
      <div>
        <p class="rotulo">Cuándo</p>
        {CULTOS.map((c) => <p>{c.dia} {c.hora} · {c.nombre}</p>)}
      </div>
      <div>
        <p class="rotulo">Contacto</p>
        <p><a href={waGeneral} target="_blank" rel="noopener noreferrer">WhatsApp</a></p>
        <p><a href={`tel:+52${IGLESIA.telefonoVisible.replace(/\s/g, "")}`}>{IGLESIA.telefonoVisible}</a></p>
        <p class="pista">{IGLESIA.horarioAtencion}. Contesta {IGLESIA.quienContesta}.</p>
      </div>
      <div>
        <p class="rotulo">Tus datos</p>
        <p class="pista">
          Esta página no tiene formularios y no guarda ningún dato tuyo. Si escribes por WhatsApp,
          esa conversación queda en la aplicación, que es de Meta. Usamos tu nombre solo para
          esperarte en la puerta.
        </p>
      </div>
    </div>

    <div class="envoltura pie__cierre">
      <p class="pista">{IGLESIA.nombreCompleto} · {IGLESIA.ciudad}, {IGLESIA.estado} · {anio}</p>
    </div>
  </footer>
</Base>

<style>
  /* ───────────────────────────────────────────── barra fija */
  .barra {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--marca);
    color: var(--texto);
  }
  .barra__caja {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    padding-block: var(--e-3);
  }
  .barra__cuando {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--e-2) var(--e-3);
    margin: 0;
    max-width: none;
  }
  .barra__cuando .dato {
    font-size: var(--fs-dato);
    color: var(--violeta);
  }
  .barra__donde {
    font-size: var(--fs-legal);
    color: var(--texto);
  }
  .barra__acciones {
    display: flex;
    gap: var(--e-2);
    flex: 1 1 auto;
  }
  .barra__acciones .boton {
    flex: 1 1 0;
    padding-inline: var(--e-4);
    white-space: nowrap;
  }
  @media (min-width: 40rem) {
    .barra__acciones {
      flex: 0 0 auto;
    }
  }

  /* ───────────────────────────────────────────── portada */
  .portada {
    position: relative;
    overflow: hidden;
    padding-block: var(--e-16) var(--e-12);
    border-bottom: 1px solid var(--linea);
  }

  /* La franja de luz. Estatica, nunca animada: con la CPU estrangulada seis
     veces, una capa de mezcla sube el primer pintado de 264 a 501 ms, asi que
     animarla costaria 237 ms por cuadro. */
  .portada__luz {
    position: absolute;
    inset: -30% -20% -10% -25%;
    background: linear-gradient(
      108deg,
      transparent 0 30%,
      rgb(176 165 255 / 0.06) 34%,
      rgb(92 200 232 / 0.13) 40% 58%,
      rgb(176 165 255 / 0.05) 62%,
      transparent 66%
    );
    pointer-events: none;
  }

  /* Se muestra solo cuando hay sitio de sobra. Por debajo de 68rem la columna
     de texto ya ocupa el ancho util y el muro seria ruido detras de la frase. */
  .portada__muro {
    display: none;
  }
  @media (min-width: 68rem) {
    .portada__muro {
      display: block;
      position: absolute;
      top: -8%;
      right: -2%;
      width: 40%;
      pointer-events: none;
      opacity: 0.55;
      /* El muro se disuelve hacia el texto: sin la mascara seria un recorte
         rectangular pegado, que es justo lo que delata un adorno. */
      -webkit-mask-image: radial-gradient(120% 90% at 78% 42%, #000 26%, transparent 72%);
      mask-image: radial-gradient(120% 90% at 78% 42%, #000 26%, transparent 72%);
    }
  }

  .portada__caja {
    position: relative;
  }
  .portada__frase {
    margin-top: var(--e-4);
    max-width: 18ch;
  }
  .portada__apoyo {
    margin-top: var(--e-3);
    font-size: var(--fs-dato);
    color: var(--texto-2);
  }

  /* En oscuro, lo que recibe la luz es lo que brilla. Esta caja es el unico
     elemento con halo de la pagina, y no es adorno: es donde cae la franja de
     luz y donde estan el horario y la direccion, que es lo que la persona vino
     a buscar. Contraste sobre el vidrio: texto 14.64, secundario 8.25. */
  .cuando {
    display: grid;
    gap: var(--e-4);
    margin: var(--e-8) 0 0;
    padding: var(--e-6);
    background: var(--vidrio);
    border: 1px solid rgb(92 200 232 / 0.28);
    border-radius: var(--radio);
    max-width: 34rem;
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 0 0 1px rgb(92 200 232 / 0.08), 0 30px 70px -40px rgb(92 200 232 / 0.55);
  }
  .cuando__fila dd {
    margin: var(--e-1) 0 0;
    display: grid;
    gap: var(--e-1);
  }
  .cuando__hora {
    font-size: var(--fs-h2);
    font-family: var(--titulo);
    line-height: 1;
  }
  .cuando__dir {
    font-size: var(--fs-dato);
    font-weight: 700;
  }
  .cuando__nota {
    font-size: var(--fs-legal);
    color: var(--texto-2);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-6);
  }

  /* ───────────────────────────────────────────── primera vez */
  .pregunta {
    margin-top: var(--e-8);
    padding-top: var(--e-4);
    border-top: 2px solid var(--cian);
  }
  .pregunta h3 {
    display: flex;
    align-items: baseline;
    gap: var(--e-3);
    margin-bottom: var(--e-3);
  }
  /* Numerador de documento. Es decorativo, por eso va oculto a lectores: el
     encabezado ya dice la pregunta completa. */
  .pregunta__num {
    font-family: var(--titulo);
    font-size: 0.72em;
    color: var(--violeta);
    /* sin opacidad: al 75% caia a 4.14:1, por debajo del piso. En barro pleno
       da 7.6 y ademas se lee como numeracion de documento, que es lo que es. */
    letter-spacing: 0.02em;
    flex: none;
  }
  .pregunta p + p {
    margin-top: var(--e-3);
  }
  /* Lleva .vidrio en el marcado, asi que el fondo lo pone esa clase. Aqui solo
     el filete de acento que la distingue del resto de preguntas. */
  .destacado {
    border-left: 4px solid var(--cian);
    padding: var(--e-6);
  }

  .minutos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e-4);
  }
