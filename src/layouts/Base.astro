---
import { Font } from "astro:assets";
import "../estilos/base.css";
import Barra from "../componentes/Barra.astro";
import { IGLESIA, CULTOS } from "../datos/iglesia";
import { revisarAntesDePublicar, datosSinConfirmar } from "../lib/candado";

const domingo = CULTOS.find((c) => c.principal)!;

/* Si quedan datos sin confirmar, esto detiene el build de produccion. */
revisarAntesDePublicar();

interface Props {
  titulo: string;
  descripcion: string;
  /* La pagina que abre con la portada reserva la primera pantalla completa:
     la banda de borrador y la portada se reparten 100svh menos la barra, asi
     que la portada no queda empujada fuera de pantalla por el alto de la
     banda, que cambia con el ancho y con el texto. */
  primeraPantalla?: boolean;
}
const { titulo, descripcion, primeraPantalla = false } = Astro.props;
const borrador = datosSinConfirmar();

/* El sitio vive en un subdirectorio, asi que ninguna ruta interna puede empezar
   por barra. BASE_URL ya trae la barra final cuando hay base configurada. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rutaDe = (archivo: string) => `${base}/${archivo}`;
/* La barra final NO es cosmetica: sin ella, new URL("tarjeta.jpg", ...) resuelve
   contra el directorio padre y la tarjeta de WhatsApp apunta a la raiz del
   dominio, donde no existe. */
const urlDelSitio = new URL(`${base}/`, Astro.site).href;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Una linea, antes de pintar: sin esta marca no existe ninguna regla que
         oculte contenido, asi que sin JavaScript se ve todo. La firma de la
         portada es CSS y se apaga sola al terminar; si esa animacion no llega a
         correr, la red de seguridad la da por terminada a los 2.2 s. Con
         movimiento reducido no hay estado de entrada en absoluto. -->
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.dataset.js = "";
        if (!matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          h.dataset.firma = "lista";
          return;
        }
        function fin() {
          h.dataset.firma = "lista";
        }
        document.addEventListener(
          "animationend",
          function (e) {
            if (e.animationName === "entra-luz") fin();
          },
          true,
        );
        setTimeout(fin, 2200);
      })();
    </script>
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#f3ede3" />
    <!-- Un solo icono, escalable, declarado una sola vez. sizes="any" le dice al
         navegador que este SVG sirve para cualquier tamano y que no busque otro.
         Medido en la vista previa, tres cargas frias con la pagina recorrida y
         ocho segundos de espera: una peticion de favicon.svg por carga. -->
    <link rel="icon" href={rutaDe("favicon.svg")} type="image/svg+xml" sizes="any" />
    <link rel="canonical" href={urlDelSitio} />

    <!-- Las dos fuentes salen del propio dominio, con su subconjunto latino y
         sus metricas de respaldo. -->
    <Font cssVariable="--fuente-titular" preload />
    <Font cssVariable="--fuente-cuerpo" preload />

    {
      /* Mientras falten datos por confirmar, esta pagina NO puede salir en
         Google: una direccion o un horario incompletos en un resultado de
         busqueda mandan a alguien a una puerta cerrada. Se quita solo cuando la
         iglesia confirme, porque depende de la misma bandera que la banda. */
      borrador && <meta name="robots" content="noindex, nofollow" />
    }

    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlDelSitio} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_MX" />
    <!-- La tarjeta que pinta WhatsApp cuando alguien manda la invitacion. Es la
         unica imagen del sitio y no es una foto: es tipografia y la misma
         celosia de la portada. -->
    <meta property="og:image" content={new URL("tarjeta.jpg", urlDelSitio).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- El alt describe la tarjeta que se ve, no lo que la pagina querria que
         dijera: fondo de cal, la celosia de luz de la portada y las tres lineas
         de texto, en ese orden. Las tres salen de los mismos datos que la
         tarjeta, asi que si cambia la hora o la calle, cambia tambien aqui. -->
    <meta
      property="og:image:alt"
      content={`Tarjeta de fondo cal con la celosía de luz de la portada. Dice: Aquí se puede llegar cansado. ${domingo.dia}s ${domingo.hora}. ${IGLESIA.calle}, ${IGLESIA.colonia}.`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google no busca "Bethel" para encontrar esta iglesia: busca "iglesia
         cristiana en Matias Romero". El dato estructurado ayuda a que el mapa
         local la reconozca, que es donde ocurre el descubrimiento real. -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Church",
        name: `${IGLESIA.nombreCompleto}, ${IGLESIA.ciudad}`,
        address: {
          "@type": "PostalAddress",
          streetAddress: IGLESIA.direccion,
          addressLocality: IGLESIA.ciudad,
          addressRegion: IGLESIA.estado,
          postalCode: IGLESIA.cp,
          addressCountry: "MX",
        },
        telephone: `+52${IGLESIA.telefonoVisible.replace(/\s/g, "")}`,
      })}
    />
  </head>

  <body>
    <a class="saltar" href="#horario">Ir al horario y la dirección</a>
    <a class="saltar" href="#contenido">Ir al contenido</a>

    <Barra />

    <main id="contenido">
      <div class:list={["primera", primeraPantalla && "primera--llena"]}>
        {
          borrador && (
            <p class="borrador no-imprimir" role="status">
              <strong>Borrador.</strong> Son de la iglesia el horario, la dirección, el teléfono y
              las prédicas. Falta confirmar si ese teléfono recibe WhatsApp y cómo se escribe el
              correo, y falta lo de adentro: la entrada, qué pasa, los niños y quién es quién.
            </p>
          )
        }
        <slot name="primera" />
      </div>

      <slot />
    </main>

    <!-- El cierre va FUERA de main. Dentro, un <footer> no es un punto de
         referencia de la pagina y un lector de pantalla no lo ofrece en su lista
         de regiones; fuera, es el contentinfo del documento y se salta a el de
         un golpe. -->
    <slot name="pie" />

    <script>
      /* El cargador decide si este aparato recibe movimiento antes de pedir una
         sola linea de GSAP. Nada mas cuelga de aqui. */
      import { arrancarMovimiento } from "../movimiento/cargador";
      arrancarMovimiento();
    </script>

    <style>
      /* La primera pantalla: banda de borrador y portada se reparten lo que
         queda del viewport bajo la barra. Cuando la banda desaparezca, la
         portada se queda con todo sin tocar una linea. */
      .primera--llena {
        min-height: calc(100svh - var(--barra));
        display: grid;
        grid-template-rows: auto 1fr;
        /* La unica columna se ata al viewport: sin el minmax, el ancho
           intrinseco de la portada la ensanchaba a 328 px en pantallas de
           320 y aparecia una barra horizontal. */
        grid-template-columns: minmax(0, 1fr);
      }
      .primera--llena > * {
        min-width: 0;
      }
    </style>
  </body>
</html>
