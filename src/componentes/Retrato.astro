---
/* El retrato de una persona, como pieza terminada.

   Un cuadrado con las iniciales en Fraunces y la sombra de celosía cruzando la
   esquina; debajo, fuera del cuadrado, el nombre, la función y una línea de
   contexto. El día que llegue la foto con autorización escrita, el cuadrado la
   recibe y las iniciales desaparecen: no hay nada que rediseñar.

   Las iniciales son decorado y van `aria-hidden`: el nombre completo está justo
   debajo, en texto, y un lector de pantalla no tiene por qué oír "A J" antes de
   oír el nombre. Sin `alt` no hay `<img>`. */

interface Props {
  nombre: string;
  funcion: string;
  contexto?: string;
  foto?: string;
  alt?: string;
}
const { nombre, funcion, contexto, foto, alt } = Astro.props;

const iniciales = nombre
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0].toUpperCase())
  .join("");

const hayFoto = Boolean(foto && alt);
---

<li class="retrato">
  <div class="retrato__cuadro">
    {
      hayFoto ? (
        <img src={foto} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <span class="retrato__iniciales" aria-hidden="true">
          {iniciales}
        </span>
      )
    }
  </div>
  <p class="retrato__nombre">{nombre}</p>
  <p class="retrato__funcion">{funcion}</p>
  {contexto && <p class="retrato__contexto">{contexto}</p>}
</li>

<style>
  .retrato {
    display: grid;
    gap: 4px;
  }
  .retrato__cuadro {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 14px;
    background: var(--cal-sombra);
    display: grid;
    place-items: center;
    margin-bottom: 10px;
    isolation: isolate;
  }
  .retrato__cuadro img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* La misma celosía de la portada, cruzando la esquina. Decorado puro: no pasa
     por debajo de ninguna letra porque el nombre va fuera del cuadrado. */
  .retrato__cuadro::before {
    content: "";
    position: absolute;
    inset: -12% -18% auto auto;
    width: 66%;
    height: 76%;
    background-image: var(--celosia);
    background-size: var(--modulo) var(--modulo);
    opacity: 0.16;
    transform: skewX(-10deg);
    -webkit-mask-image: linear-gradient(200deg, #000, transparent 82%);
    mask-image: linear-gradient(200deg, #000, transparent 82%);
    z-index: 1;
  }
  .retrato__iniciales {
    position: relative;
    z-index: 2;
    font-family: var(--titular);
    font-weight: 600;
    font-size: clamp(2.6rem, 14vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--tinta);
  }
  .retrato__nombre {
    font-family: var(--titular);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .retrato__funcion {
    color: var(--luz-clara);
    font-size: 16px;
  }
  .retrato__contexto {
    color: var(--techo-suave);
  }
</style>
