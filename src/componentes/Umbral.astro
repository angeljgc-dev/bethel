---
/* El umbral: cruzar el portón.

   Dos paneles del mismo tamaño, uno encima del otro. El de arriba es el portón
   verde y se recorta como un ojo de cerradura hasta desaparecer; debajo aparece
   la sala, que es la respuesta a "cuánto dura".

   Tres cosas que son decisiones, no adorno:

   1. El portón va ANTES que Adentro en el HTML. Sin JavaScript se cruza el
      portón y después se entra, nunca al revés.
   2. Toda la geometría del cruce (los dos paneles superpuestos y el alto de una
      pantalla que los contiene) cuelga de html[data-anima], que solo pone la
      coreografía cuando GSAP ya está. Sin JavaScript, con GSAP caído o con
      movimiento reducido, esto es un panel corto y una sección normal, apilados
      y completos. El recorrido del cruce tampoco se escribe aquí: lo pone el
      espaciador del pin, así que no hay ningún alto de pista que mantener a
      mano.
   3. Cuánto dura no es un letrero de paso dentro del panel verde: es la
      pregunta 02, con su encabezado, su dato grande y su cuerpo, en su posición
      de reposo. En el panel solo va la frase del cruce, que es decorado y por
      eso va aria-hidden. Esa frase sale de `COMO_LLEGAR.cruce` y hoy está
      vacía: decía "Cruzas el portón" y nadie ha confirmado que la entrada sea
      un portón. Mientras el dato falte, el panel cruza sin frase; no se pierde
      ningún dato porque nunca llevó ninguno.

   La segunda instancia (`variante="luz"`) es la misma máquina al revés. Aquí el
   panel que se recorta es el de abajo del documento, no el de arriba: crece
   desde el centro con `circle(0%)` a `circle(120%)` y va tapando la cal. Por eso
   los papeles se cambian: el panel que se recorta es el que lleva el contenido
   (queda entero y quieto al final del recorrido, que es su posición de reposo,
   exactamente como Adentro en la primera instancia) y el que se queda debajo es
   el decorado. Lo que va dentro lo pone quien la usa, por el slot. */

import { CULTOS, PRIMERA_VEZ, COMO_LLEGAR } from "../datos/iglesia";
import { finDe, duracionEnHoras } from "../lib/candado";

interface Props {
  variante?: "porton" | "luz";
}
const { variante = "porton" } = Astro.props;

const domingo = CULTOS.find((c) => c.principal)!;
const fin = finDe(domingo);
const dura = duracionEnHoras(domingo.minutos);
---

{
  variante === "porton" ? (
    <div class="umbral umbral--porton">
      <div class="umbral__porton" aria-hidden="true">
        {COMO_LLEGAR.cruce && <p class="cruce">{COMO_LLEGAR.cruce}</p>}
      </div>

      <section class="umbral__adentro" id="adentro" aria-labelledby="adentro-titulo">
        <p class="rotulo">Ya adentro · 2 a 6 de 7</p>
        <h2 id="adentro-titulo">Esto es lo que va a pasar</h2>
        <p class="entrada">Un domingo normal, con tiempos. Para que no haya sorpresas.</p>

        <div class="pregunta">
          <h3>¿Cuánto dura?</h3>
          <p class="dato-grande">{dura}</p>
          <p>
            Empieza a las {domingo.hora} y termina a las {fin}. {PRIMERA_VEZ.salir}
          </p>
        </div>
      </section>
    </div>
  ) : (
    <div class="umbral umbral--luz">
      <div class="umbral__previo" aria-hidden="true">
        <p class="cruce">Se apaga la luz.</p>
      </div>
      <div class="umbral__luz">
        <slot />
      </div>
    </div>
  )
}

<style>
  .umbral {
    position: relative;
  }
  /* Con la coreografía puesta el umbral mide una pantalla y los dos paneles
     ocupan esa misma pantalla, uno encima del otro. El recorrido del cruce NO
     se escribe aquí: lo añade el espaciador del pin, así que el alto de la
     pista y la duración del recorte son el mismo número por construcción. */
  :global(html[data-anima]) .umbral {
    height: calc(100svh - var(--barra));
    overflow: clip;
  }

  .umbral__porton,
  .umbral__adentro,
  .umbral__previo,
  .umbral__luz {
    position: relative;
    padding: 40px 20px;
  }

  :global(html[data-anima]) .umbral__porton,
  :global(html[data-anima]) .umbral__adentro,
  :global(html[data-anima]) .umbral__previo,
  :global(html[data-anima]) .umbral__luz {
    position: absolute;
    inset: 0;
    padding: 24px 20px;
    overflow: clip;
  }
  /* Adentro está debajo y el portón encima, que es el que se recorta. En la
     variante de la luz los papeles se cambian: el decorado abajo y el panel que
     crece encima. */
  :global(html[data-anima]) .umbral__adentro,
  :global(html[data-anima]) .umbral__previo {
    z-index: 1;
  }
  :global(html[data-anima]) .umbral__porton,
  :global(html[data-anima]) .umbral__luz {
    z-index: 2;
  }

  .umbral__porton {
    background: var(--porton);
    color: var(--cal-porton);
    display: grid;
    align-content: center;
  }
  /* El panel que queda detrás de la segunda cerradura: la cola de Prédicas, con
     una frase de decorado que no lleva ningún dato y va aria-hidden. */
  .umbral__previo {
    background: var(--cal-sombra);
    color: var(--tinta);
    display: grid;
    align-content: center;
  }
  .umbral__luz {
    background: var(--techo);
    color: var(--cal-porton);
    display: grid;
    align-content: end;
  }
  /* Sin la coreografía el panel de la luz no se recorta y no tiene por qué medir
     una pantalla: es una sección más, apilada y completa. */
  :global(html[data-anima]) .umbral__luz {
    padding: 0;
  }
  .cruce {
    font-family: var(--titular);
    font-weight: 600;
    line-height: 1.02;
    font-size: clamp(2rem, 8vw, 4.5rem);
    max-width: 14ch;
  }

  .umbral__adentro {
    background: var(--techo);
    color: var(--cal-porton);
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .umbral__adentro .rotulo {
    color: var(--luz);
  }
  .umbral__adentro h2 {
    font-size: clamp(2.1rem, 8.5vw, 5rem);
  }
  .entrada {
    color: var(--techo-suave);
    max-width: 34rem;
  }
  .pregunta {
    margin-top: 14px;
    display: grid;
    gap: 6px;
    max-width: 34rem;
  }
  .pregunta h3 {
    font-size: clamp(1.5rem, 6vw, 2.4rem);
  }
  .dato-grande {
    font-family: var(--titular);
    font-weight: 600;
    font-size: clamp(2.6rem, 12vw, 4.6rem);
    line-height: 1;
    color: var(--luz);
  }

  @media (min-width: 900px) {
    .umbral__porton,
    .umbral__adentro,
    .umbral__previo,
    .umbral__luz {
      padding: 64px;
    }
    :global(html[data-anima]) .umbral__porton,
    :global(html[data-anima]) .umbral__adentro,
    :global(html[data-anima]) .umbral__previo {
      padding: 48px 64px;
    }
    :global(html[data-anima]) .umbral__luz {
      padding: 0;
    }
  }
</style>
