---
/* La línea de tiempo del domingo. Pregunta 03.

   Los seis tramos salen de `PRIMERA_VEZ.tramos` con sus minutos de inicio y de
   fin en números, y el total sale de la duración del culto. El riel, las marcas
   y el contador se calculan de esos números: cambiar la hora o la duración en
   `iglesia.ts` cambia esta sección entera sin tocar una línea de aquí.

   El reposo es una lista: seis tarjetas apiladas, cada una con su rango y su
   texto completo. Con la coreografía puesta esa misma lista se convierte en una
   pista horizontal que avanza con el scroll, y el riel de arriba marca en qué
   minuto va. Sin JavaScript, con GSAP caído o con movimiento reducido, la lista
   se queda como está: nada se oculta ni se recorta. */

import { CULTOS, PRIMERA_VEZ } from "../datos/iglesia";
import { finDe } from "../lib/candado";

const domingo = CULTOS.find((c) => c.principal)!;
const total = domingo.minutos;
const tramos = PRIMERA_VEZ.tramos;

/* Las marcas del riel son los inicios de cada tramo mas el final. Si algun dia
   la duracion del culto baja y los tramos todavia no se han corregido, las
   marcas que se salgan no se dibujan: mejor un riel corto que un riel mentiroso. */
const marcas = [...tramos.map((t) => t.desde).filter((m) => m < total), total];
const porcentaje = (minuto: number) => ((minuto / total) * 100).toFixed(3);

/* Las dos horas de los extremos del riel. Van escritas en hora de reloj y no en
   minutos porque son las que alguien compara con su reloj, y salen de la hora
   de entrada y de la duracion: cambiar "10:00" en iglesia.ts las mueve las dos.

   Solo se rotulan los extremos. Las marcas de en medio son rayas sin numero: a
   390 px, dos tramos que empiezan con diez minutos de diferencia (85 y 95) dejan
   sus rotulos a 22 px uno de otro y se tocan. El dato completo de cada tramo
   esta en su tarjeta, que es texto de lectura; el riel es dibujo. */
const empieza = domingo.hora;
const termina = finDe(domingo);
---

<section
  class="minutos caja"
  id="minutos"
  aria-labelledby="minutos-titulo"
  data-total={total}
  data-paradas={tramos.map((t) => t.desde).join(",")}
>
  <div class="minutos__cabeza">
    <h3 id="minutos-titulo">¿Qué va a pasar, minuto a minuto?</h3>
    <div class="riel" aria-hidden="true">
      <div class="riel__pista">
        {marcas.map((m) => <span class="riel__marca" style={`left:${porcentaje(m)}%`}></span>)}
        <span class="riel__sol" style="left:0%"></span>
      </div>
      <p class="riel__horas"><b>{empieza}</b><b>{termina}</b></p>
      <p class="riel__contador">minuto <span data-minuto>0</span> de {total}</p>
    </div>
  </div>

  <ol class="pista">
    {
      tramos.map((t) => (
        <li class="tramo">
          <b>
            Minuto {t.desde} a {t.hasta}
          </b>
          <p>{t.texto}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* minmax(0, 1fr) y no la columna por omision: con la coreografia puesta la
     pista pasa a flex con seis tarjetas de flex: 0 0 auto, y el contenido minimo
     de esa columna pasa a ser la pista entera. Sin este tope, la columna, y con
     ella la cabecera y el riel, crecian hasta el ancho de la pista: 1,832 px a
     390. Medido: el rotulo "13:00" quedaba 1,462 px fuera de la pantalla y el
     h3 se cortaba a 320. Con el tope, la cabecera mide el ancho de la pantalla
     menos el padding, y la pista desborda dentro de su propia caja, que es lo
     que la seccion recorta. */
  .minutos {
    background: var(--techo);
    color: var(--cal-porton);
    padding-block: 40px 48px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    overflow: clip;
  }
  /* Fijada, la sección mide una pantalla y el bloque entero (titular, riel,
     contador y tarjetas) se centra en ella. El aire de arriba y el de abajo son
     el mismo número para que el centrado sea exacto: con 40 y 72 el bloque
     quedaba 16 px por encima del centro. */
  :global(html[data-anima]) .minutos {
    height: calc(100svh - var(--barra));
    align-content: center;
    padding-block: 24px;
  }

  .minutos h3 {
    font-size: clamp(1.7rem, 6.5vw, 3rem);
    max-width: 20ch;
  }

  /* El riel: la regla de los minutos del culto. Es dibujo, el dato completo
     está en cada tarjeta. */
  .riel {
    margin-top: 18px;
    display: grid;
    gap: 10px;
  }
  .riel__pista {
    position: relative;
    height: 26px;
    border-top: 2px solid rgba(243, 237, 227, 0.28);
  }
  .riel__marca {
    position: absolute;
    top: -2px;
    width: 1px;
    height: 8px;
    background: rgba(243, 237, 227, 0.45);
  }
  .riel__horas {
    display: flex;
    justify-content: space-between;
    margin-top: -6px;
  }
  .riel__horas b {
    font-family: var(--cuerpo);
    font-weight: 400;
    font-size: 16px;
    color: var(--techo-suave);
  }
  .riel__sol {
    position: absolute;
    top: -9px;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border-radius: 50%;
    background: var(--luz);
    box-shadow: 0 0 0 6px rgba(242, 193, 94, 0.25);
  }
  .riel__contador {
    margin-top: 6px;
    color: var(--luz-clara);
    font-size: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Reposo: seis tarjetas apiladas, completas. */
  .pista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  /* En reposo la tarjeta es un párrafo de lectura y no una banda: sin tope, a
     1920 el texto del tramo salía a 212 caracteres por renglón. */
  .tramo {
    max-width: 34rem;
    background: rgba(243, 237, 227, 0.06);
    border: 1px solid rgba(243, 237, 227, 0.18);
    border-radius: 14px;
    padding: 18px;
  }
  .tramo b {
    display: block;
    font-family: var(--titular);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.05;
    margin-bottom: 8px;
    color: var(--luz-clara);
  }
  .tramo p {
    color: var(--cal-porton);
  }

  /* Con la coreografía puesta la misma lista es una pista horizontal. Lo que
     sobresale de la caja lo recorta el overflow de la sección.

     Ya no lleva el margen negativo con el padding compensado que tenía antes:
     existía para meter el margen derecho dentro de scrollWidth, y el recorrido
     ya no se calcula con scrollWidth sino con el borde de la última tarjeta. */
  :global(html[data-anima]) .pista {
    display: flex;
    grid-template-columns: none;
    gap: 16px;
    will-change: transform;
  }
  /* El ancho de la tarjeta ES el recorrido del pin: seis tarjetas de 78vw piden
     1,555 px de scroll a 390, seis de 74vw piden 1,444 y seis de 66vw piden
     1,256. Con el tope de 14 pantallas a 390 y la banda de borrador ya en su
     tamano de cuerpo, esos 188 px son la diferencia entre 14.17 y 13.94.

     El limite de angostar no es horizontal sino vertical: la seccion mide una
     pantalla menos la barra y recorta lo que sobre, y una tarjeta mas angosta es
     mas alta. Medido a 320, 375 y 390, y ademas en una pantalla corta de 700 px:
     el alto del contenido de la seccion nunca pasa del alto de la seccion y
     ninguna de las seis tarjetas se sale de ella. El texto del tramo mas largo
     sigue entero, con un renglon mas. */
  :global(html[data-anima]) .tramo {
    flex: 0 0 auto;
    width: min(66vw, 26rem);
  }

  @media (min-width: 900px) {
    .riel {
      max-width: none;
    }
    .minutos h3 {
      max-width: none;
    }
  }
</style>
