---
/* El hueco de una foto que todavía no existe.

   No es un cajón que diga "aquí va la foto": es una pieza terminada, con su
   marco, su sombra de celosía y su pie, que el día que llegue el archivo lo
   recibe sin rediseñar nada. Lo que va dentro lo pone quien lo usa.

   Dos reglas de UX que aquí se cumplen en código:

   - Con la bandera de la iglesia en true y sin archivo, el hueco NO se
     renderiza: ni caja, ni rótulo, ni pie. Un hueco publicado es un sitio a
     medio hacer.
   - La excepción es lo que es contenido y no hueco (la placa del callejón):
     eso lleva `siempre` y se publica con o sin foto, porque lo que dice es
     verdad y le sirve a quien busca la puerta.

   Sin `alt` no hay `<img>`: una foto sin texto alternativo no se publica. */

import { datosSinConfirmar } from "../lib/candado";

interface Props {
  src?: string;
  alt?: string;
  pie?: string;
  siempre?: boolean;
  clase?: string;
}
const { src, alt, pie, siempre = false, clase = "" } = Astro.props;

const hayFoto = Boolean(src && alt);
const seMuestra = hayFoto || siempre || datosSinConfirmar();
---

{
  seMuestra && (
    <figure class={`hueco ${clase}`}>
      {hayFoto ? (
        <img class="hueco__foto" src={src} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <div class="hueco__marco">
          <slot />
        </div>
      )}
      {pie && <figcaption>{pie}</figcaption>}
    </figure>
  )
}

<style>
  .hueco {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .hueco__marco {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 16px;
    background: var(--placa);
    border: 1px solid rgba(243, 237, 227, 0.28);
    display: grid;
    align-content: end;
    padding: 20px;
    isolation: isolate;
  }
  /* La misma celosía de la portada, de refilón: el hueco pertenece a la casa. */
  .hueco__marco::before {
    content: "";
    position: absolute;
    inset: -10% -20% auto auto;
    width: 70%;
    height: 80%;
    background-image: var(--celosia);
    background-size: var(--modulo) var(--modulo);
    opacity: 0.18;
    transform: skewX(-10deg);
    -webkit-mask-image: linear-gradient(200deg, #000, transparent 80%);
    mask-image: linear-gradient(200deg, #000, transparent 80%);
    z-index: 0;
  }
  .hueco__marco::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(160deg, rgba(242, 193, 94, 0.22), transparent 45%);
  }
  .hueco__foto {
    display: block;
    width: 100%;
    border-radius: 16px;
  }
  .hueco figcaption {
    color: var(--cal-porton);
    font-size: 1em;
  }
</style>
